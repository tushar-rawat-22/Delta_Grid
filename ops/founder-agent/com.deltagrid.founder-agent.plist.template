<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.deltagrid.founder-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__AGENT_SCRIPT__</string>
    <string>--config</string>
    <string>__AGENT_CONFIG__</string>
  </array>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_ROOT__/founder-agent.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_ROOT__/founder-agent.err.log</string>
</dict>
</plist>
