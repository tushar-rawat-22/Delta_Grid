{
  "contract_id": "NEWS_CONTEXT_OFFLINE_REPLAY_V1",
  "schema_version": 1,
  "status": "PROPOSED_OFFLINE_ONLY",
  "authority_effect": "NONE",
  "purpose": "Deterministic, synthetic-only point-in-time News Context replay contract. This contract does not activate collection, research evaluation, signals, trading, or capital authority.",
  "source_families": [
    "GDELT",
    "SEC"
  ],
  "scope": {
    "external_fetch": false,
    "live_ingest": false,
    "retained_external_corpus": false,
    "economic_evaluation": false,
    "protected_split_opening": false,
    "direction_signal": false,
    "paper_trading": false,
    "live_trading": false,
    "credential_access": false,
    "order_submission": false,
    "capital_authority": false
  },
  "required_record_fields": [
    "source_family",
    "first_seen_at",
    "fetched_at",
    "dedupe_key",
    "availability_state"
  ],
  "available_record_required_fields": [
    "source_native_ref",
    "published_at",
    "provenance_sha256"
  ],
  "availability_states": [
    "AVAILABLE",
    "SOURCE_UNAVAILABLE",
    "NO_RESULT",
    "SCHEDULER_GAP"
  ],
  "point_in_time_rules": {
    "timestamp_format": "UTC_RFC3339_Z",
    "available_record_order": "published_at <= first_seen_at <= fetched_at <= replay_cutoff",
    "missing_state_order": "first_seen_at <= fetched_at <= replay_cutoff",
    "eligible_at_replay": "first_seen_at <= replay_cutoff AND fetched_at <= replay_cutoff",
    "future_known_records": "REJECT"
  },
  "provenance_rules": {
    "hash": "sha256_lower_hex_64",
    "available_record_requires_source_native_ref": true,
    "available_record_requires_provenance_sha256": true,
    "missing_state_must_not_invent_publication_or_content_provenance": true
  },
  "dedupe_rules": {
    "key_uniqueness": "UNIQUE_WITHIN_REPLAY_FIXTURE",
    "duplicate_action": "REJECT"
  },
  "forbidden_authority_fields": [
    "direction_signal",
    "trade_action",
    "position",
    "order",
    "capital_action",
    "prediction"
  ],
  "explicitly_deferred": [
    "live GDELT collection",
    "live SEC collection",
    "source-diversity feature computation",
    "novelty feature computation",
    "disagreement feature computation",
    "tone-distribution feature computation",
    "persistence/decay feature computation",
    "baseline-vs-news economic ablation",
    "protected evaluation",
    "public observer News Context rendering"
  ],
  "evidence_boundary": {
    "fixtures": "SYNTHETIC_METADATA_ONLY",
    "software_test_is_alpha_evidence": false,
    "news_direction_authority": false
  }
}
